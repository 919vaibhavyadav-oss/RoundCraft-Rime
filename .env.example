# Placeholders only. Never commit a live credential.

# Rime — the primary spoken output. Exact configuration is documented in README.md.
RIME_API_KEY=your_rime_api_key
RIME_MODEL=coda
RIME_LANG=eng
# Must match LiveKit's room audio (48kHz). Anything else resamples every
# frame, and soxr aborts the process with LSX_FFT_BR == NULL under load.
RIME_SAMPLE_RATE=48000

# LiveKit — realtime transport
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Speech recognition
DEEPGRAM_API_KEY=your_deepgram_api_key

# The model that writes each interviewer's question
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=your_model_id
# Keep the reply short. Free tiers cap output tokens per minute and reject a
# request whose *budget* exceeds the cap, before generating anything.
LLM_MAX_TOKENS=150
# Thinking tokens are spent against that same cap and never reach the
# candidate. Set to low/medium/high only if a model needs it.
LLM_REASONING_EFFORT=none

# The tool call the candidate is meant to interrupt. Raise this when
# recording if the window is tight to hit by hand.
LOOKUP_DELAY_SECONDS=3.0
